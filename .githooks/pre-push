#!/bin/sh

echo "=== Running integration/scenario tests before push ==="

PYTHON=python
for candidate in "./.venv_pc/Scripts/python.exe" "./.venv_laptop/Scripts/python.exe" "./.venv/Scripts/python.exe"; do
    if [ -f "$candidate" ]; then
        PYTHON="$candidate"
        break
    fi
done

"$PYTHON" ./tools/scripts/run_remaining_tests.py
if [ $? -ne 0 ]; then
    echo "Error: integration tests failed. Push aborted."
    exit 1
fi

if [ -f "package.json" ]; then
    VERSION=$("$PYTHON" -c "import json; print(json.load(open('package.json', encoding='utf-8'))['version'])" 2>/dev/null)
    if [ -n "$VERSION" ]; then
        TAG_NAME="v$VERSION"
        if ! git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
            echo "Creating Git tag $TAG_NAME locally..."
            git tag -a "$TAG_NAME" -m "Release $TAG_NAME"
        fi
        if ! git ls-remote --tags origin "$TAG_NAME" | grep -q "$TAG_NAME" 2>/dev/null; then
            echo "Pushing tag $TAG_NAME to origin..."
            git push origin "$TAG_NAME" --no-verify
        fi
    fi
fi

exit 0
