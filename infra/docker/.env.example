# Copy this file to .env for operation and replace the secret below.
# Do not commit or share the real .env file.
#
# PowerShell random value example:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))

SHIM_SECRET_KEY=replace_with_long_random_secret_key_before_operation

# 사업장 시간대(IANA 이름). 미설정 시 Asia/Seoul을 사용합니다.
# 잘못된 이름이면 애플리케이션이 기동하지 않습니다. 예: America/New_York
SHIM_TIMEZONE=Asia/Seoul

# 데이터 저장 디렉터리 경로 설정
# - 개발 저장소 내 기동 시: ../../var/data (기본값)
# - 운영/독립 서버 배포 시: ./var/data
SHIM_DATA_DIR=./var/data