# 이 파일을 프로젝트 루트의 .env로 복사하고 아래 비밀키를 설정합니다.
# 실제 .env는 커밋하거나 공유하지 마십시오.
#
# 안전한 무작위 키 생성 예:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

SHIM_SECRET_KEY=

# 사업장 시간대(IANA 이름). 미설정 시 Asia/Seoul을 사용합니다.
# 잘못된 이름이면 애플리케이션이 기동하지 않습니다. 예: America/New_York
SHIM_TIMEZONE=Asia/Seoul

# HTTPS 리버스 프록시 운영 시 true, 직접 HTTP 시험 시 false
SHIM_SECURE_COOKIE=false

# 개발 환경에서만 true로 설정하면 /docs, /redoc, /openapi.json을 제공합니다.
# 운영 기본값은 false이며 OpenAPI 비공개는 인증이나 접근 통제를 대체하지 않습니다.
SHIM_ENABLE_OPENAPI=false

# Compose 기준 ../../var/data는 프로젝트 루트의 var/data를 가리킵니다.
SHIM_DATA_DIR=../../var/data
