# 런타임 DB·로컬 데이터 (볼륨 마운트로만 사용)
var/data/
data/

# 운영 비밀값·데이터는 이미지에 포함하지 않음
**/.env
**/.env.*
**/secret.key
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.bak
**/*.log

# 로컬 개발
.venv/
.venv_pc/
.venv_laptop/
venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
.git/
.gitignore
.githooks/
.agents/
.codex/
.antigravitycli/

# Node (이미지에는 불필요, 정적 CSS는 빌드 후 static에 포함하거나 별도 처리)
node_modules/
package.json
package-lock.json
tailwind.config.js
src/static/css/app.css

# 포터블 빌드 산출물
dist/
build/
*.spec

# IDE
.idea/
.vscode/

# 문서·설계·포터블·개발 자료
design/
docs/
openwiki/
portable/
scratch/
AGENTS.md
GEMINI.md
README.md
requirements-dev.txt
tools/scripts/*
